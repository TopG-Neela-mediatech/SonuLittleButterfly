    foregroundSprite: {fileID: 21300000, guid: 0bfdfae5cd1f05f4183080a201dbd672, type: 3}
    captionText: 'Sonu: "Mummy, can we help?" Madhavi: "Yes! The egg needs a healthy
      leaf, the caterpillar needs food, and the butterfly needs nectar."'
    displayDuration: 4
    transitionIn: 0
    transitionOut: 1
